	test_cell () {

		ff ("IQ" , "IQN") {
			next_state         	: "D";
			clocked_on         	: "CLK";
			clear              	: "!RN";
		}
		pin (D) {
			direction	: input;
		}
		pin (RN) {
			direction	: input;
		}
		pin (SE) {
			direction	: input;
			signal_type	: test_scan_enable;
		}
		pin (SI) {
			direction	: input;
			signal_type	: test_scan_in;
		}
		pin (CLK) {
			direction	: input;
		}
		pin (Q) {
			direction	: output;
			function	: "IQ";
			signal_type	: test_scan_out;
		}
	}

  }


  /******************************************************************************************
   Module          	: SDFFSNQ_X1
   Cell Description	: Pos.edge D-Flip-Flop with active high scan, and active low set, and drive strength X1
  *******************************************************************************************/

  cell (SDFFSNQ_X1) {

	ff ("IQ" , "IQN") {
		next_state         	: "((SE * SI) + (!SE * D))";
		clocked_on         	: "CLK";
		preset             	: "!SN";
	}

	drive_strength	: 1;

	area               	: 1.622016;
	pg_pin(VDD) {
		voltage_name : VDD;
		pg_type      : primary_power;
	}
	pg_pin(VNW) {
		voltage_name : VNW;
		pg_type      : nwell;
	}
	pg_pin(VPW) {
		voltage_name : VPW;
		pg_type      : pwell;
	}
	pg_pin(VSS) {
		voltage_name : VSS;
		pg_type      : primary_ground;
	}


