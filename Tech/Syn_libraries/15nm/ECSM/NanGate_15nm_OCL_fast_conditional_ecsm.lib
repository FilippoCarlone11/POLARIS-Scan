	test_cell () {

		ff ("IQ" , "IQN") {
			next_state         	: "D";
			clocked_on         	: "CLK";
			clear              	: "!RN";
		}
		pin (D) {
			direction	: input;
		}
		pin (RN) {
			direction	: input;
		}
		pin (SE) {
			direction	: input;
			signal_type	: test_scan_enable;
		}
		pin (SI) {
			direction	: input;
			signal_type	: test_scan_in;
		}
		pin (CLK) {
			direction	: input;
		}
		pin (Q) {
			direction	: output;
			function	: "IQ";
			signal_type	: test_scan_out;
		}
	}

  }


  /******************************************************************************************
   Module          	: SDFFSNQ_X1
   Cell Description	: Pos.edge D-Flip-Flop with active high scan, and active low set, and drive strength X1
