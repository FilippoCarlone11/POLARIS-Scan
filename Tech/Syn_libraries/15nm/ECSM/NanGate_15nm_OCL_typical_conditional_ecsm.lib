	test_cell () {

		ff ("IQ" , "IQN") {
			next_state         	: "D";
			clocked_on         	: "CLK";
			clear              	: "!RN";
		}
		pin (D) {
			direction	: input;
		}
		pin (RN) {
			direction	: input;
		}
		pin (SE) {
			direction	: input;
			signal_type	: test_scan_enable;
		}
		pin (SI) {
			direction	: input;
			signal_type	: test_scan_in;
		}
		pin (CLK) {
			direction	: input;
		}
		pin (Q) {
			direction	: output;
			function	: "IQ";
			signal_type	: test_scan_out;
		}
	}

  }


