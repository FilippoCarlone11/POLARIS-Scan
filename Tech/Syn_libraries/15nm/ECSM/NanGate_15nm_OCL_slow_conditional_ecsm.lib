	test_cell () {

		ff ("IQ" , "IQN") {
			next_state         	: "D";
			clocked_on         	: "CLK";
			preset             	: "!SN";
		}
		pin (D) {
			direction	: input;
		}
		pin (SE) {
			direction	: input;
			signal_type	: test_scan_enable;
		}
		pin (SI) {
			direction	: input;
			signal_type	: test_scan_in;
		}
		pin (SN) {
			direction	: input;
		}
		pin (CLK) {
			direction	: input;
		}
		pin (Q) {
			direction	: output;
			function	: "IQ";
			signal_type	: test_scan_out;
		}
	}

  }


