read_verilog b08.v
hierarchy -check -top b08
synth -top b08
opt -full                       
splitnets -ports
opt_clean -purge
dfflibmap -liberty /app/Tech/Syn_libraries/45nm/lib/NangateOpenCellLibrary_typical.lib
